SUPABASE_URL=
SUPABASE_ANON_KEY=

# Só no servidor (Vercel / .env.local). Nunca no browser.
# Usada para ler os tokens e avisar o app no celular.
SUPABASE_SERVICE_ROLE_KEY=

# Worker R2 (mesmo do AdoptNow). Só no servidor.
R2_UPLOAD_URL=https://adoptnow-r2-upload.adoptnow.workers.dev
R2_PUBLIC_URL=https://pub-69fe052b8ea841d295431051a32c1c9d.r2.dev
FORM_UPLOAD_KEY=

# Verificação automática da foto do documento (Google Gemini). Só no servidor.
# Sem a chave, o cadastro é aceito e marcado como "nao_verificado".
GEMINI_API_KEY=
# Opcional. Padrão: gemini-flash-latest
GEMINI_MODEL=

# Mercado Pago (Pix das rifas). Só no servidor / Vercel.
MERCADOPAGO_ACCESS_TOKEN=
# Segredo do webhook (opcional no começo; recomendado em produção)
MERCADOPAGO_WEBHOOK_SECRET=
# Opcional. Padrão: https://recantoronron.vercel.app
NEXT_PUBLIC_SITE_URL=https://recantoronron.vercel.app

